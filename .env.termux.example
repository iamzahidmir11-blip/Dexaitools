# Copy this file to .env and fill in your own values.
# Never commit .env or share API keys publicly.

# Required for AI replies
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_QUICK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# Local PostgreSQL database (created by TERMUX.md instructions)
DATABASE_URL=postgresql://cumulo:CHANGE_THIS_PASSWORD@127.0.0.1:5432/cumulomind

# Local web app
FRONTEND_ORIGIN=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5000
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional billing settings; leave empty if not using Stripe locally
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
